modules = ["python-3.11", "nodejs-20"]

[nix]
channel = "stable-24_05"
packages = ["libxcrypt"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Web Application"

[[workflows.workflow]]
name = "Web Application"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && node server.js"
waitForPort = 5000

[deployment]
run = ["sh", "-c", "cd frontend && node server.js"]

[[ports]]
localPort = 5000
externalPort = 80
