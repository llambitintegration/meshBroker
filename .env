# MQTT Broker settings
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=meshtastic_fastapi_bridge
MQTT_USERNAME=admin
MQTT_PASSWORD=admin
MQTT_USE_TLS=false
MQTT_KEEPALIVE=60
MQTT_QOS=1

# Meshtastic settings
MESHTASTIC_TOPIC_PREFIX=msh/tx/
MESHTASTIC_RECONNECT_INTERVAL=10

# API settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO 