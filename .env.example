# MQTT Broker settings
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=meshtastic_fastapi_bridge
MQTT_USERNAME=admin
MQTT_PASSWORD=changeme
MQTT_USE_TLS=false
MQTT_KEEPALIVE=60
MQTT_QOS=1

# Message persistence settings
PERSISTENCE_ENABLED=true
PERSISTENCE_PATH=mqtt_data

# Message queue settings
MAX_QUEUE_SIZE=10000
QUEUE_WORKER_COUNT=2
HIGH_WATERMARK=0.8
LOW_WATERMARK=0.6

# Retry settings
MAX_RETRIES=5
BASE_RETRY_DELAY=1.0
MAX_RETRY_DELAY=60.0

# Broker monitoring settings
BROKER_MONITOR_ENABLED=true
BROKER_CHECK_INTERVAL=30.0

# Meshtastic settings
MESHTASTIC_TOPIC_PREFIX=msh/tx/
MESHTASTIC_RECONNECT_INTERVAL=10

# API settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO 